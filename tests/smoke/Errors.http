@baseUrl = http://localhost:5182


### Unsupported paymentTypeCode ("XX") on instruction 0 — whole batch rejected
### in full. Only the paymentTypeCode is invalid; everything else matches the valid batch above so
### the failure is isolated. Expect: 200 OK, Success: false, Errors: ["Unsupported payment type
### 'XX'."] tied to instruction index 0.
POST {{baseUrl}}/convert
Content-Type: application/json

[
  {
    "paymentTypeCode": "XX",
    "accountNo": "S1605677",
    "sourceBankAccountNo": "111375004",
    "sourceBankBSB": "015141",
    "paymentDate": "2026-08-20T10:00:00",
    "amount": 7500.0
  }
]

### Mixed paymentTypeCode (found 'BPAY', 'DE') — whole batch rejected
### in full. Only the paymentTypeCode is invalid; everything else matches the valid batch above so
### the failure is isolated. Expect: 200 OK, Success: false, Errors: ["Payment batch must not mix payment types (found 'BPAY', 'DE')."].
POST {{baseUrl}}/convert
Content-Type: application/json

[
  {
    "paymentTypeCode": "BPAY",
    "accountNo": "S1605677",
    "sourceBankAccountNo": "111375004",
    "sourceBankBSB": "015141",
    "paymentDate": "2026-08-20T10:00:00",
    "amount": 7500.0
  },
  {
    "paymentTypeCode": "DE",
    "accountNo": "S1605678",
    "sourceBankAccountNo": "222486115",
    "sourceBankBSB": "063111",
    "paymentDate": "2026-08-20T10:00:00",
    "amount": 12500.0
  }
]


### Mixed paymentTypeCode (found 'DE', 'RTGS') — whole batch rejected in full, per existing
### PaymentTypeRouter mixed-type rejection behaviour (see Errors.http). Only the paymentTypeCode
### mix is invalid; the RTGS instruction on its own matches the valid batch above.
### Expect: 200 OK, Success: false, Errors: ["Payment batch must not mix payment types (found 'DE', 'RTGS')."].
POST {{baseUrl}}/convert
Content-Type: application/json

[
  {
    "paymentTypeCode": "DE",
    "accountNo": "S1605677",
    "sourceBankAccountNo": "111375004",
    "sourceBankBSB": "015141",
    "paymentDate": "2026-08-20T10:00:00",
    "amount": 7500.0
  },
  {
    "paymentTypeCode": "RTGS",
    "destinationBankAccountName": "ORS APP GATB",
    "destinationBankAccountNo": "838629371",
    "destinationBankBSB": "012110",
    "paymentDate": "2026-08-18T10:00:00",
    "amount": 10775.0,
    "notes": "Accounts has been paid to before.",
    "beneficiaryAddress": null
  }
]


### Invalid instruction: blank destinationBankBSB (must be exactly 6 numeric digits) on instruction 0
