@baseUrl = http://localhost:5182


### Unsupported paymentTypeCode ("XX") on instruction 0 — whole batch rejected
### in full. Only the paymentTypeCode is invalid; everything else matches the valid batch above so
### the failure is isolated. Expect: 200 OK, Success: false, Errors: ["Unsupported payment type
### 'XX'."] tied to instruction index 0.
POST {{baseUrl}}/convert
Content-Type: application/json

[
  {
    "paymentTypeCode": "XX",
    "accountNo": "S1605677",
    "paymentSourceTypeCode": "CMA",
    "sourceBankAccountName": "SOPHIA CLARK",
    "sourceBankAccountNo": "111375004",
    "sourceBankBSB": "015141",
    "paymentDate": "2026-08-20T10:00:00",
    "sourceCurrency": "AUD",
    "sourceAmount": 0.0,
    "amount": 7500.0,
    "createBy": "James Harris"
  }
]

