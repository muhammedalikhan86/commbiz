@baseUrl = http://localhost:5182

### Valid batch: 1 real sample instruction (Priority Payments, routed via API code "RTGS" — the
### file's own Transaction Type field is always the constant "PP"). Domestic BSB-based payment, no
### SWIFT/currency/intermediary fields populated. BeneficiaryAddress omitted (optional field).
### Expect: 200 OK, Success: true, ConvertedText populated (single 27-field CSV row, no trailing
### CRLF, no header/trailer record), Mappings populated with 1 entry keyed "row1", Errors: null.
POST {{baseUrl}}/convert
Content-Type: application/json

[
  {
    "paymentTypeCode": "RTGS",
    "paymentSourceTypeCode": "CMA",
    "sourceBankAccountName": "J & D SARGENT SUPER CO PTY LTD ATF JASON & DYNA SARGENT SF",
    "sourceBankAccountNo": "114316871",
    "sourceBankBSB": "012141",
    "destinationBankAccountName": "ORS APP GATB",
    "destinationBankAccountNo": "838629371",
    "destinationBankBSB": "012110",
    "paymentDate": "2026-08-18T10:00:00",
    "sourceCurrency": "AUD",
    "sourceAmount": 0.0,
    "amount": 10775.0,
    "notes": "Accounts has been paid to before.",
    "beneficiaryAddress": null
  }
]

### Valid batch: 2 instructions, second one with a populated BeneficiaryAddress (letters/numbers/
### spaces only — no hyphen/apostrophe, per the stricter PP address rule).
### Expect: 200 OK, Success: true, ConvertedText populated (two 27-field CSV rows joined by CRLF,
### no trailing CRLF), Mappings populated with 2 entries keyed "row1"/"row2", Errors: null.
POST {{baseUrl}}/convert
Content-Type: application/json

