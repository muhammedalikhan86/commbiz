### Mixed paymentTypeCode (found 'DE', 'RTGS') — whole batch rejected in full, per existing
### PaymentTypeRouter mixed-type rejection behaviour (see Errors.http). Only the paymentTypeCode
### mix is invalid; the RTGS instruction on its own matches the valid batch above.
### Expect: 200 OK, Success: false, Errors: ["Payment batch must not mix payment types (found 'DE', 'RTGS')."].
POST {{baseUrl}}/convert
Content-Type: application/json

[
  {
    "paymentTypeCode": "DE",
    "accountNo": "S1605677",
    "paymentSourceTypeCode": "CMA",
    "sourceBankAccountName": "SOPHIA CLARK",
    "sourceBankAccountNo": "111375004",
    "sourceBankBSB": "015141",
    "paymentDate": "2026-08-20T10:00:00",
    "sourceCurrency": "AUD",
    "sourceAmount": 0.0,
    "amount": 7500.0,
    "createBy": "James Harris"
  },
  {
    "paymentTypeCode": "RTGS",
    "paymentSourceTypeCode": "CMA",
    "sourceBankAccountName": "J & D SARGENT SUPER CO PTY LTD ATF JASON & DYNA SARGENT SF",
    "sourceBankAccountNo": "114316871",
    "sourceBankBSB": "012141",
    "destinationBankAccountName": "ORS APP GATB",
    "destinationBankAccountNo": "838629371",
    "destinationBankBSB": "012110",
    "paymentDate": "2026-08-18T10:00:00",
    "sourceCurrency": "AUD",
    "sourceAmount": 0.0,
    "amount": 10775.0,
    "notes": "Accounts has been paid to before.",
    "beneficiaryAddress": null
  }
]

